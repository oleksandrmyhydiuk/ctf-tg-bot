# Copy to .env and fill in: cp .env.example .env

# Bot token from @BotFather (required)
BOT_TOKEN=123456789:replace_with_your_token

# Path to SQLite file (optional, defaults to sandbox.db).
# Ignored in docker compose: the database lives in a volume (/data/sandbox.db).
DB_PATH=sandbox.db

# Docker runtime for additional isolation (optional).
# Leave empty for default runc; set to "runsc" if gVisor is installed.
DOCKER_RUNTIME=

# Hard container disk limit (optional). Works only on Linux hosts with
# overlay2 on xfs (pquota); leave empty on Docker Desktop/Windows: the limit
# is enforced by the watchdog (MAX_DISK_BYTES in config.py).
DOCKER_STORAGE_SIZE=

# Docker compose only: path to Docker socket on the host
# (defaults to /var/run/docker.sock; change for rootless Docker).
# DOCKER_SOCK=/var/run/docker.sock
